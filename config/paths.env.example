# Machine-specific paths. Copy to config/paths.env (git-ignored) and edit; or export the same variables.
# Loaded by p3d_env.py (repo scripts, run_all.py) and sourced by the shell scripts. $HOME and ~ are expanded.

# conda envs kiss_icp, erasor2, calib (pytorch3d for the LV-DOT baseline) live in $P3D_CONDA_ENVS/<env>
P3D_CONDA_ENVS=$HOME/mambaforge/envs
# P3D_PY_CALIB=/some/other/python          # per-env interpreter override (P3D_PY_KISS_ICP, P3D_PY_ERASOR2, ...)
# P3D_ERASOR2_BIN=                          # default: <repo>/third_party/ERASOR2/build/run_erasor2

# ROS 2 bags, one directory per bag; outputs are written to <bag>/slam_output/
P3D_BAGS_GO2NUS=/data/go2nus_annotated
P3D_ZIPS_MIRAIKAN=/data/miraikan_zips
P3D_BAGS_MIRAIKAN=/data/miraikan_reconstruction

# extracted per-trajectory data (frames, lidar, traj_data.pkl, 2D tracks) + intrinsics/ and extrinsics/
P3D_PROCESSED=/data/processed
# VGGT-Omega depth per dataset (P3D_DEPTH_ALT: second drive used for datasets processed later; defaults to P3D_DEPTH)
P3D_DEPTH=/data/processed_depth
# P3D_DEPTH_ALT=/data2/ped3d_depth
# person masks per dataset
P3D_MASKS=/data/mask_dataset
# 15 Hz REGROUP detections per dataset
P3D_REGROUP=/data/regroup_detections
# ped3d outputs: <dataset>/<traj>.pkl, tracks_<dataset>.pkl, extrinsics_est/, tracking/
P3D_PED3D_OUT=/data/ped3d

# optional
P3D_FIG_OUT=/data/figures                   # figure scripts output
P3D_LVDOT_OUT=/data/lvdot_eval              # LV-DOT baseline results
# P3D_UMICH_BAGS=/data/umich_split_bags     # ped3d/extract_umich_extrinsics.py
# P3D_YOLO_SEG=yolo11x-seg.pt               # weights for figures/blog_scripts/_blur.py (name = downloaded by ultralytics)
# P3D_SCRATCH=/tmp                          # pipeline/groups_eval/run.py
# P3D_LEG_DETECTOR_WS=$HOME/leg_detector_ws # ROS 2 workspace of the leg-detector baseline

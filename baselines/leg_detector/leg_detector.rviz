Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: odom
      Plane Cell Count: 60
      Cell Size: 1
      Color: 160; 160; 164
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Local map
      Enabled: true
      Topic:
        Value: /local_map
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.4
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar (raw)
      Enabled: true
      Topic:
        Value: /rslidar_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 150; 150; 150
      Alpha: 0.25
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: Leg-height scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/Marker
      Name: Leg detector markers
      Enabled: true
      Topic:
        Value: /visualization_marker
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces: {}
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Arrows: false
      Show Axes: true
      Marker Scale: 0.6
      Frames:
        All Enabled: false
        base_link:
          Value: true
        odom:
          Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 34
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: base_link
      Scale: 40
      X: 0
      Y: 0
Window Geometry:
  Width: 1600
  Height: 950
